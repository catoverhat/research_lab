{
  "name": "research-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import ./test-hooks.mjs --test \"src/**/*.test.ts\"",
    "test:e2e": "node e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:migrations:list": "supabase migration list --remote",
    "supabase:migration:new": "supabase migration new",
    "supabase:migrations:up:local": "supabase migration up",
    "supabase:db:reset:local": "supabase db reset",
    "supabase:test:local": "supabase test db",
    "supabase:db:push:dry-run": "supabase db push --dry-run --remote",
    "supabase:types": "supabase gen types typescript --schema public > src/shared/database/database.types.ts",
    "supabase:types:remote": "supabase gen types typescript --schema public --remote > src/shared/database/database.types.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.19.0",
    "supabase": "3.4.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
