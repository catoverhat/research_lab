# Copy to .env.local. Local values come from `pnpm supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Cloudflare's test site key (always passes). Production uses the real one.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# For the local Auth server, in supabase/.env (read by config.toml):
# SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
