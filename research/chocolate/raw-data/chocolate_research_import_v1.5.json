  "safety_notes": [
    {
      "topic": "alcalinización",
      "statement": "No se considera motivo por sí solo para evitar cacao en cantidades alimentarias habituales; puede reducir flavanoles. No se conoce grado de alcalinización de Munné."
    },
    {
      "topic": "cumarina",
      "statement": "BfR: ingesta tolerable 0.1 mg/kg/día; Cassia promedio ~3 mg/g, variable. No se conoce especie ni concentración de Líder. No inferir seguridad individual."
    },
    {
      "topic": "maltitol",
      "statement": "Valor 0% contiene maltitol según registro previo; cantidad no conocida. Puede causar molestias gastrointestinales según dosis y tolerancia."
    },
    {
      "topic": "caducidad",
      "statement": "Verificar fecha de Chocolala antes de consumo; lectura previa de foto incierta."
    }
